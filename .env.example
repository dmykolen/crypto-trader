# Copy to .env and fill in. Never commit .env.

# --- Anthropic (news triage, analyst briefs, strategy reviews) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_FAST_MODEL=claude-haiku-5-5
LLM_DEEP_MODEL=claude-opus-5-5

# --- Storage ---
DATA_DIR=data
REPORTS_DIR=reports
DATABASE_URL=sqlite:///data/trader.db

# --- Exchange: Binance USDⓈ-M (only needed for TRADING_MODE=live; CCXT_API_KEY / CCXT_SECRET also accepted) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
TRADING_MODE=paper

# --- Research assumptions (shared by backtests and the paper broker) ---
ENTRY_LATENCY_S=60
TAKER_FEE=0.0005
EVENT_SLIPPAGE=0.0015

# --- Risk rails (paper + live) ---
MAX_LEVERAGE=20
MARGIN_FRACTION=0.2
MAX_NOTICE_FRACTION=0.3
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS=0.2
PAPER_EQUITY=1000
MAX_NOTICE_AGE_S=300
LLM_NEWS_TRADING=false

# --- API process: also run the news watcher + trader loop inside uvicorn ---
RUN_WATCHER=false
LOG_LEVEL=INFO
LOG_FORMAT=text
